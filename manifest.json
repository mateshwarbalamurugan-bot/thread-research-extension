{
  "manifest_version": 3,
  "name": "THREAD — Visual Evidence Mapping",
  "version": "0.1.0",
  "description": "Capture and organize web evidence for research.",
  "permissions": ["storage", "contextMenus", "tabs"],
  "background": {
  "service_worker": "background.js",
  "type": "module"
},
  "action": {
    "default_popup": "popup.html",
    "default_title": "Open THREAD"
  }
}
